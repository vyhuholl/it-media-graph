# Copy to deploy/inventory.ini — which .gitignore keeps out of the
# repository, because it names the server and the laptop, and nothing
# committed may name either. The example addresses are RFC 5737
# documentation addresses; never real ones.
#
# [collector] is the k3s host. Everything the playbook does there goes
# over SSH as root, through `k3s kubectl`: the deploy installs nothing
# and changes nothing outside the itgraph namespace.
#
# itgraph_storage_class is the host's storage class for the three volume
# claims — the database with its snapshots, the Telegram session, the
# dumps — and none of them can be rebuilt. So the class must keep a
# volume's data when its claim is deleted (`reclaimPolicy: Retain`), and
# `--tags prepare` refuses one that does not. k3s's own `local-path`
# deletes it: on a plain k3s, add a class of the same provisioner with
# `reclaimPolicy: Retain`. A claim keeps the class it was made with;
# claims already made on the wrong one are deleted — while they are
# still empty — and made again.
#
# [previous] is the host the Telegram session comes from — the laptop,
# until it is retired. It is consulted only during a cutover, only when
# the session volume is empty, and only to confirm it has stopped
# collecting. Its user needs to read systemd, not to be root.

[collector]
itgraph ansible_host=192.0.2.10 ansible_user=root itgraph_storage_class=example-retaining-class

[previous]
laptop ansible_host=192.0.2.20 ansible_user=itgraph
