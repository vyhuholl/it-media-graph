# {{ ansible_managed }}
[Unit]
Description=itgraph: daily baseline refresh

[Timer]
# Daily, in the quiet hours. A channel is measured against its own newest
# posts, so its reference is only as recent as the last refresh — and a
# reference that does not move scores a grown channel against the
# channel it used to be, which is not a subtle error: the frozen medians
# this replaced left 72 of 229 channels more than 1 z off zero.
OnCalendar={{ baselines_schedule | default('*-*-* 04:30:00') }}
# So a host that was off at the scheduled moment refreshes on the next
# boot instead of waiting another day.
Persistent=true

[Install]
WantedBy=timers.target
