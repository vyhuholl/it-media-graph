# Managed by Ansible ({{ ansible_managed }}). Edit group_vars, not this.
DATABASE_URL=postgresql+asyncpg://{{ db_user }}:{{ db_password }}@localhost:{{ db_port }}/{{ db_name }}

# A separate setting, not a repointed DATABASE_URL: the collector reads
# its settings once at startup, so a DATABASE_URL aimed at the bot role
# keeps working until something restarts and then every write fails.
BOT_DATABASE_URL=postgresql+asyncpg://itgraph_bot:{{ bot_db_password }}@localhost:{{ db_port }}/{{ db_name }}

POSTGRES_USER={{ db_user }}
POSTGRES_PASSWORD={{ db_password }}
POSTGRES_DB={{ db_name }}
POSTGRES_PORT={{ db_port }}

TELEGRAM_API_ID={{ telegram_api_id }}
TELEGRAM_API_HASH={{ telegram_api_hash }}
TELEGRAM_SESSION={{ telegram_session | default('itgraph.session') }}

TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
ALERT_CHAT_ID={{ alert_chat_id }}

{% if proxy_host is defined and proxy_host | length > 0 %}
# MTProto only. An unreachable proxy stops collection by design — there
# is no fallback to a direct connection, because a collector that
# quietly connects directly still works, which is exactly the problem.
PROXY_TYPE={{ proxy_type | default('socks5') }}
PROXY_HOST={{ proxy_host }}
PROXY_PORT={{ proxy_port }}
{% if proxy_username is defined and proxy_username | length > 0 %}
PROXY_USERNAME={{ proxy_username }}
PROXY_PASSWORD={{ proxy_password }}
{% endif %}
{% endif %}

WATCH_TIMEZONE={{ watch_timezone | default('Europe/Moscow') }}
