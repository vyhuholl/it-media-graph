# {{ ansible_managed }}
[Unit]
Description=itgraph: YouTube poll loop, every fifteen minutes

[Timer]
# Fifteen minutes is the latency of noticing an upload and the grain of
# the reading schedule, whose first age is an hour. The quota is priced
# for it: about 2,500 units a day at 500 channels, inside the poll
# loop's reserve of 3,000. No quiet hours — there is no account to look
# human, and the Moscow night is the American evening.
OnCalendar={{ yt_watch_schedule | default('*:0/15') }}
# A host that was off at a firing runs one pass when it is back. The
# schedule skips what was missed rather than replaying it.
Persistent=true

[Install]
WantedBy=timers.target
