# {{ ansible_managed }}
[Unit]
Description=itgraph: fetch again the YouTube channel data about to expire
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ ansible_user }}
WorkingDirectory={{ repo_dir }}
# What YouTube says about a channel may be kept 30 days (Developer
# Policies III.E.4), and this is what keeps it current. A spent quota or
# a failure part way exits non-zero with everything before it committed,
# so the unit shows as failed and the next run continues where this one
# stopped. The log carries channel ids only.
ExecStart={{ uv }} run itgraph yt refresh
