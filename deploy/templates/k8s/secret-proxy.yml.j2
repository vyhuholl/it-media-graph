# The proxy's whole configuration, rendered as JSON from the vault's
# outbound. Exactly one outbound and no routing section: whatever is
# not sent through the VPN server has nowhere to go, so an unreachable
# exit fails the connection instead of leaving from the host's own
# address. The one inbound is SOCKS with a password and UDP off.
apiVersion: v1
kind: Secret
metadata:
  name: itgraph-proxy
  namespace: itgraph
type: Opaque
stringData:
  config.json: |
{% set xray = {
      "log": {"loglevel": "warning"},
      "inbounds": [{
        "listen": "0.0.0.0",
        "port": 1080,
        "protocol": "socks",
        "settings": {
          "auth": "password",
          "udp": false,
          "accounts": [{"user": "itgraph", "pass": proxy_socks_password}]
        }
      }],
      "outbounds": [proxy_outbound]
    } %}
    {{ xray | tojson }}
