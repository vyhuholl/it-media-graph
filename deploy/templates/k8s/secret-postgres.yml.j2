# The three values the official image's entrypoint initializes a fresh
# database with. The application's own connection strings are in
# itgraph-env; nothing but this StatefulSet reads this Secret.
apiVersion: v1
kind: Secret
metadata:
  name: itgraph-postgres
  namespace: itgraph
type: Opaque
stringData:
  POSTGRES_USER: {{ db_user | tojson }}
  POSTGRES_PASSWORD: {{ db_password | tojson }}
  POSTGRES_DB: {{ db_name | tojson }}
