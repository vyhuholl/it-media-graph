# The scheduled passes, minutes staggered as the boot offsets once
# staggered the timers. Every job: Europe/Moscow, Forbid, no retry —
# a failed run is retried by the next firing, as a failed oneshot
# was — and an activeDeadlineSeconds that ends a stuck run, so Forbid
# cannot block every later one. The daily deadlines are the
# counterpart of `Persistent=true`: a run missed while the node was
# down starts when it is back, the same day.
#
# No config-checksum annotation here: a job's pods are new every run,
# so each one reads the Secret as it is, and there is nothing long
# running to restart.
apiVersion: batch/v1
kind: CronJob
metadata:
  name: itgraph-alerts
  namespace: itgraph
spec:
  schedule: {{ itgraph_alerts_schedule | tojson }}
  timeZone: Europe/Moscow
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 600
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      activeDeadlineSeconds: 3000
      template:
        metadata:
          labels:
            app: itgraph-alerts
        spec:
          restartPolicy: Never
          automountServiceAccountToken: false
          securityContext:
            runAsNonRoot: true
            runAsUser: 3000
            runAsGroup: 3000
            fsGroup: 3000
            seccompProfile:
              type: RuntimeDefault
          # Derive first, as an init container: `alerts` never runs on
          # edges a failed `derive` would have left stale — the reason
          # they shared a systemd unit.
          initContainers:
            - name: derive
              image: {{ itgraph_image | tojson }}
              args: ["derive"]
              envFrom:
                - secretRef:
                    name: itgraph-env
              securityContext:
                readOnlyRootFilesystem: true
                allowPrivilegeEscalation: false
                capabilities:
                  drop: ["ALL"]
              resources:
                requests:
                  cpu: 100m
                  memory: 256Mi
                limits:
                  memory: 1Gi
              volumeMounts:
                - name: tmp
                  mountPath: /tmp
          containers:
            - name: itgraph
              image: {{ itgraph_image | tojson }}
              args: ["alerts"]
              envFrom:
                - secretRef:
                    name: itgraph-env
              securityContext:
                readOnlyRootFilesystem: true
                allowPrivilegeEscalation: false
                capabilities:
                  drop: ["ALL"]
              resources:
                requests:
                  cpu: 100m
                  memory: 256Mi
                limits:
                  memory: 1Gi
              volumeMounts:
                - name: tmp
                  mountPath: /tmp
          volumes:
            - name: tmp
              emptyDir: {}
---
