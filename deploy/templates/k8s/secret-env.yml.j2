# The whole application configuration in one Secret, so that one
# SHA-256 over this file is the checksum the pod templates carry: a
# changed value here restarts the workloads, and nothing else does.
#
# This is today's env.j2 with the Compose-era keys gone: the database
# is reached at its Service, the tools run from the image, and the
# proxy always exists — there is no direct connection to configure
# away. Secret-bearing values go through `tojson`: a JSON string is a
# valid YAML scalar, and it is the only quoting that survives a
# password with a quote in it.
apiVersion: v1
kind: Secret
metadata:
  name: itgraph-env
  namespace: itgraph
type: Opaque
stringData:
  DATABASE_URL: {{ ("postgresql+asyncpg://" ~ db_user ~ ":" ~ db_password ~ "@itgraph-postgres:5432/" ~ db_name) | tojson }}
  # A separate setting, not a repointed DATABASE_URL: the collector
  # reads its settings once at startup, so a DATABASE_URL aimed at the
  # bot role keeps working until something restarts and then every
  # write fails.
  BOT_DATABASE_URL: {{ ("postgresql+asyncpg://itgraph_bot:" ~ bot_db_password ~ "@itgraph-postgres:5432/" ~ db_name) | tojson }}
  # Empty: the PostgreSQL tools are in this image, and with no Compose
  # container to exec into they run as local processes against the
  # host and port in DATABASE_URL.
  POSTGRES_CONTAINER: ""
  # The backups volume, where the backup job and the pre-migration
  # dump both write.
  BACKUP_DIR: /backups
  TZ: Europe/Moscow
  TELEGRAM_API_ID: "{{ telegram_api_id }}"
  TELEGRAM_API_HASH: {{ telegram_api_hash | tojson }}
  # The session volume, mounted where the collector and the console
  # can write it: the image's root filesystem is read-only.
  TELEGRAM_SESSION: /session/itgraph.session
  TELEGRAM_BOT_TOKEN: {{ telegram_bot_token | tojson }}
  ALERT_CHAT_ID: "{{ alert_chat_id }}"
  # The VPN exit is always configured here — the proxy is a workload
  # of the namespace, not an option.
  PROXY_TYPE: socks5
  PROXY_HOST: itgraph-proxy
  PROXY_PORT: "1080"
  PROXY_USERNAME: itgraph
  PROXY_PASSWORD: {{ proxy_socks_password | tojson }}
  WATCH_TIMEZONE: {{ watch_timezone | default("Europe/Moscow") }}
  ALERT_SPIKE_Z: "{{ alert_spike_z | default(3.7) }}"
{% if youtube_api_key | default("") | length > 0 %}
  # YouTube Data API. The key is sent in a request header, never in a
  # URL. Without it the two YouTube CronJobs are not applied at all.
  YOUTUBE_API_KEY: {{ youtube_api_key | tojson }}
{% endif %}
{% if b2_key_id | default("") | length > 0 %}
  # The off-site pass. All four or none — the settings loader refuses
  # anything in between, and on the collection host all four are set.
  B2_KEY_ID: {{ b2_key_id | tojson }}
  B2_APPLICATION_KEY: {{ b2_application_key | tojson }}
  B2_BUCKET_NAME: {{ b2_bucket_name | tojson }}
  BACKUP_AGE_RECIPIENT: {{ backup_age_recipient | tojson }}
{% endif %}
