# Copy to secrets.vault.yml and encrypt; `ansible.cfg` reads the
# password from `.vault_pass`, so nothing is prompted:
#     ansible-vault encrypt deploy/group_vars/all/secrets.vault.yml
#
# The encrypted file is committed, and the repository is public: anyone
# can fetch the ciphertext and attack the password offline for as long
# as they like, against a key derivation of only 10 000 PBKDF2 rounds.
# Its safety rests on the vault password alone, so that password comes
# from a generator, random, 20 characters or more — never one chosen to
# be remembered.
#
# The vault password itself is never committed — `.gitignore` covers
# `deploy/.vault_pass` and `deploy/group_vars/all/secrets.yml`, and a
# pre-commit hook refuses `.vault_pass` even when force-added.

telegram_api_id: 0
telegram_api_hash: ""
telegram_bot_token: ""
alert_chat_id: 0

db_password: ""
bot_db_password: ""

# The VPN exit, as xray's outbound object: the one outbound of the
# client configuration for the VPN server the previous host used,
# copied verbatim. The proxy in the namespace runs exactly this and
# nothing else — no `freedom`, no routing — so when this server cannot
# be reached, a Telegram connection fails rather than leaving from the
# host's own address. Its address belongs here as much as any key does:
# it is the address the collector's traffic is known to come from.
proxy_outbound: {}
  # protocol: …
  # settings: …

# The password the namespace's SOCKS proxy asks for. Random, from a
# generator; it never leaves the cluster and the vault.
proxy_socks_password: ""

# The off-site store: a key restricted to the one bucket, with
# listFiles and writeFiles only. Together with backup_age_recipient in
# main.yml, all four or none.
b2_key_id: ""
b2_application_key: ""
b2_bucket_name: ""

# The YouTube Data API key. On the api hash's footing: whoever holds it
# spends the quota of the one API project the policies allow. Leave
# empty on a host that does no YouTube work — the Secret then gets no
# key and the two YouTube CronJobs are not applied.
youtube_api_key: ""
