---
# Copy to secrets.vault.yml and encrypt:
#     ansible-vault encrypt group_vars/all/secrets.vault.yml
#
# `secrets.vault.yml` is git-ignored, so the encrypted file never leaves
# this machine and its safety does not rest on the vault password alone.
# The consequence is that it is also **not backed up by the repository**:
# a fresh clone has no secrets, and losing this machine loses them. Keep
# a copy wherever you keep the api hash.
#
# The vault password itself is never committed under any arrangement —
# `.gitignore` covers `deploy/.vault-pass` and `deploy/group_vars/all/secrets.yml`.

telegram_api_id: 0
telegram_api_hash: ""
telegram_bot_token: ""
alert_chat_id: 0

db_password: ""
bot_db_password: ""

# The proxy endpoint, all four parts together. The host belongs here as
# much as the password does: it is the address the collector is known to
# come from, and `all.yml` is committed in the clear. Leave empty for a
# direct connection — the playbook checks the host and skips the whole
# block when it is blank.
proxy_type: socks5
proxy_host: ""
proxy_port: 1080
proxy_username: ""
proxy_password: ""
