---
# Copy to secrets.vault.yml and encrypt; `ansible.cfg` reads the
# password from `.vault_pass`, so nothing is prompted:
#     ansible-vault encrypt deploy/group_vars/all/secrets.vault.yml
#
# The encrypted file is committed, and the repository is public: anyone
# can fetch the ciphertext and attack the password offline for as long
# as they like, against a key derivation of only 10 000 PBKDF2 rounds.
# Its safety rests on the vault password alone, so that password comes
# from a generator, random, 20 characters or more — never one chosen to
# be remembered.
#
# The vault password itself is never committed — `.gitignore` covers
# `deploy/.vault_pass` and `deploy/group_vars/all/secrets.yml`, and a
# pre-commit hook refuses `.vault_pass` even when force-added.

telegram_api_id: 0
telegram_api_hash: ""
telegram_bot_token: ""
alert_chat_id: 0

db_password: ""
bot_db_password: ""

# The proxy endpoint, all four parts together. The host belongs here as
# much as the password does: it is the address the collector is known to
# come from, and `all.yml` is committed in the clear. Leave empty for a
# direct connection — the playbook checks the host and skips the whole
# block when it is blank.
proxy_type: socks5
proxy_host: ""
proxy_port: 1080
proxy_username: ""
proxy_password: ""
