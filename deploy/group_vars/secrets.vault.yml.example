---
# Copy to secrets.vault.yml and encrypt:
#     ansible-vault encrypt group_vars/secrets.vault.yml
#
# Encrypted, this file is safe to commit and is meant to be. What must
# never be committed is the vault password — `.gitignore` covers
# `deploy/.vault-pass` and `deploy/group_vars/secrets.yml`.

telegram_api_id: 0
telegram_api_hash: ""
telegram_bot_token: ""
alert_chat_id: 0

db_password: ""
bot_db_password: ""

proxy_password: ""
