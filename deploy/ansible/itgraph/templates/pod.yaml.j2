{#- A pod the role runs once, reads and deletes: bare and not a Job, so that one
    expected to fail raises no shared alert.

    It waits a moment before it does anything. The cluster's network policies reach a
    new pod a fraction of a second after it starts, and until then the database and
    the proxy refuse it: measured at about 0.3 s, enough to make a `curl` read a
    working proxy as a broken one. -#}
{%- set settle = {
      'name': 'settle',
      'image': __itgraph_shot.spec.containers[0].image,
      'command': ['sleep', '3'],
      'securityContext': __itgraph_container_security,
      'resources': {'requests': {'cpu': '10m', 'memory': '16Mi'}, 'limits': {'memory': '64Mi'}},
    } -%}
apiVersion: v1
kind: Pod
metadata:
  name: {{ __itgraph_shot.name }}
  namespace: {{ itgraph_namespace | to_json }}
  labels: {{ ({'app': __itgraph_shot.name} | combine(__itgraph_shot.labels | default({}))) | to_json }}
spec: {{ __itgraph_shot.spec | combine({'initContainers': [settle]}) | to_json }}
