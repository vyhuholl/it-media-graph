# Database settings
DATABASE_URL=postgresql+asyncpg://itgraph:itgraph@localhost:5433/itgraph

# Telegram API id and API hash. Нужны только командам, которые подключаются
# к Telegram: `login`, `dump-dialogs`, `add`, `backfill`, `resolve`,
# `metadata`, `watch`. Пусто — такие команды откажутся, называя эти
# настройки; всё остальное работает.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telethon session file. Full account access — never commit it.
TELEGRAM_SESSION=itgraph.session

# Прокси для MTProto: через него идут login, dump-dialogs, add, backfill,
# resolve, metadata и watch. Бот работает по Bot API поверх обычного HTTPS
# и не проксируется никогда.
#
# Не задано — соединение прямое (так работает ноутбук). Задано —
# запасного пути нет: недоступный прокси останавливает команду, и это
# сделано нарочно. Прокси, который молча падает на прямое соединение,
# хуже, чем его отсутствие: процесс работает, в логах всё зелёно, а
# аккаунт всё это время ходит с того адреса, который прятали.
#
# Заполнять целиком: половина настроек — ошибка при загрузке настроек, а
# не при первом соединении. PROXY_PASSWORD не коммитить, как и api hash.
# PROXY_TYPE=socks5
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# TELEGRAM_BOT_TOKEN=

# Оповещения: один чат-форум и три его топика — телеграмный,
# английский и русский. Задаются все четыре или ни одного; без них
# оповещения не отправляются. Id топика — из ссылки на сообщение в нём.
# ALERT_CHAT_ID=
# TELEGRAM_ALERT_TOPIC=
# YOUTUBE_ALERT_TOPIC_EN=
# YOUTUBE_ALERT_TOPIC_RU=

# Ключ YouTube Data API v3. Секрет на тех же правах, что api hash: не
# коммитить и не светить. Кто владеет ключом, тот тратит квоту
# единственного API-проекта (по правилам YouTube проект у клиента ровно
# один), так что утечка — это чужие запросы за наш счёт до замены ключа.
# Пусто — откажутся команды, которые ходят в API YouTube: сбор, обновление,
# поиск и lookup. Скоринг, базовые линии, списки недели и отбор считаются
# по собранному и работают без ключа; Telegram и бот его не замечают.
# YOUTUBE_API_KEY=
