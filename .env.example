# Database settings
DATABASE_URL=postgresql+asyncpg://itgraph:itgraph@localhost:5433/itgraph

# Telegram API id and API hash
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telethon session file. Full account access — never commit it.
TELEGRAM_SESSION=itgraph.session

# Прокси для MTProto: через него идут login, backfill, resolve, metadata
# и watch. Бот работает по Bot API поверх обычного HTTPS и не
# проксируется никогда.
#
# Не задано — соединение прямое (так работает ноутбук). Задано —
# запасного пути нет: недоступный прокси останавливает команду, и это
# сделано нарочно. Прокси, который молча падает на прямое соединение,
# хуже, чем его отсутствие: процесс работает, в логах всё зелёно, а
# аккаунт всё это время ходит с того адреса, который прятали.
#
# Заполнять целиком: половина настроек — ошибка при загрузке настроек, а
# не при первом соединении. PROXY_PASSWORD не коммитить, как и api hash.
# PROXY_TYPE=socks5
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Бот подключается под отдельной ролью с правами только на таблицы
# оповещений. Отдельная переменная, а не подменённый DATABASE_URL:
# коллектор читает настройки один раз при старте, поэтому .env,
# указывающий на роль бота, работает до первого перезапуска — а потом
# у сбора отказывает вся запись сразу.
# Роль создаёт миграция, пароль задаётся руками:
#   ALTER ROLE itgraph_bot LOGIN PASSWORD '...';
# BOT_DATABASE_URL=postgresql+asyncpg://itgraph_bot:пароль@localhost:5433/itgraph

# TELEGRAM_BOT_TOKEN=
# ALERT_CHAT_ID=
